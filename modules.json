{
  "$schema": "weirdos-modules/1",
  "description": "Bausteine von WeirdOS: Schalter, Abhaengigkeiten, SoC-Grenzen, Profile. Eine Quelle fuer Firmware (weirdos_features.h / weirdos_module_rules.h) und Cam-Tool. Siehe MODULES.md.",
  "macro_prefix": "WEIRDOS_FEATURE_",
  "soc_caps": {
    "wifi":   { "label": "WLAN-Funk im Chip",        "true_on": ["esp32", "esp32s2", "esp32s3", "esp32c3", "esp32c6"], "false_on": ["esp32p4"] },
    "ble":    { "label": "BLE-Funk im Chip",         "true_on": ["esp32", "esp32s3", "esp32c3", "esp32c6"],           "false_on": ["esp32s2", "esp32p4"] },
    "usb_otg":{ "label": "USB-OTG (Host + Device)",  "true_on": ["esp32s2", "esp32s3", "esp32p4"],                    "false_on": ["esp32", "esp32c3", "esp32c6"] },
    "h264hw": { "label": "HW-H.264-Encoder + PPA",   "true_on": ["esp32p4"] },
    "camera": { "label": "DVP- oder MIPI-Kamera",    "false_on": ["esp32c3", "esp32c6"] },
    "psram":  { "label": "PSRAM bestueckt",          "note": "Board-Eigenschaft (CONFIG_SPIRAM)" }
  },
  "modules": [
    { "key": "CAMERA",     "layer": "hardware", "label": "Kamera",            "status": "declared", "default": "soc:camera",  "requires": [], "soc": ["camera"], "psram": true,
      "files": ["camera_manager.*", "camera_device.h", "camera_frame.h", "frame_source.h", "camera_compat.h", "esp32s3_camera_device.*", "esp32p4_camera_device.*", "camera_stream_service.*"],
      "hint": "Sensor und Bildpfad. Ohne das ist es keine Kamera. Braucht zur Laufzeit PSRAM." },
    { "key": "USB_HOST",   "layer": "hardware", "label": "USB-Host",          "status": "declared", "default": "soc:usb_otg", "requires": [], "soc": ["usb_otg"],
      "files": ["usb_host-Aufrufe in weirdos-esp32.ino"], "hint": "USB-OTG-Host. Fundament fuer das Modem." },
    { "key": "USB_DEVICE", "layer": "hardware", "label": "USB-Geraet (TinyUSB)", "status": "wired", "default": 0, "requires": [], "soc": ["usb_otg"],
      "files": ["usb_device_service.*", "tinyusb_class_stubs.c"], "cost": { "static_ram_kb": 48 },
      "hint": "TinyUSB-Device-Stack: ~48 KB statisches internes RAM, sobald gelinkt. Grundlage fuer UVC und USB_NCM." },
    { "key": "WIFI",       "layer": "hardware", "label": "WLAN",              "status": "declared", "default": "soc:wifi",    "requires": ["NET"], "soc": ["wifi"],
      "files": ["wifi_caps.*", "WiFi-/SoftAP-/Captive-Portal-Code in weirdos-esp32.ino"], "hint": "STA + AP + Captive-Portal + mDNS. Grosser Posten im statischen RAM." },
    { "key": "BLE",        "layer": "hardware", "label": "Bluetooth LE",      "status": "wired",    "default": "soc:ble",     "requires": [], "soc": ["ble"],
      "files": ["bt_scan.*", "ui_bluetooth.cpp"], "hint": "BLE-Scan/Kopplung (NimBLE). Kostet spuerbar internen RAM." },

    { "key": "NET",        "layer": "network", "label": "IP-Stack",           "status": "declared", "default": 1, "requires": [],
      "files": ["network_registry.*", "network_platform.*", "egress_policy.*", "wan_policy.*", "wan_service.*", "access_policy.*", "network_mode.*"],
      "hint": "lwIP/esp_netif, Netz-Registry, Egress-/WAN-Policy. Fundament jedes Netz-Bausteins. Die USB-Webcam braucht ihn nicht." },
    { "key": "MODEM",      "layer": "network", "label": "LTE-Modem (EC200A)", "status": "declared", "default": "soc:usb_otg", "requires": ["USB_HOST", "NET"],
      "files": ["ec200a_modem.*", "ec200a_ecm.*", "modem_datalink.*", "modem_sim.*", "modem_clock.*"], "cost": { "flash_kb": 136, "static_ram_kb": 40 },
      "hint": "USB, AT, PPP/ECM-Datenpfad, SIM, Netzzeit. Haelt 18-48 KB internes DMA-RAM." },
    { "key": "USB_NCM",    "layer": "network", "label": "USB-Netzwerkadapter", "status": "planned",  "default": 0, "requires": ["USB_DEVICE", "NET"],
      "files": [], "hint": "ESP als Netzwerkadapter am PC (Downlink fuer Tethering/VPN-LAN). Noch nicht implementiert." },
    { "key": "ROUTER",     "layer": "network", "label": "Netzzonen / Router", "status": "wired",    "default": "soc:psram", "requires": ["NET"], "psram": true,
      "files": ["zone_runtime.*", "zone_planner_adapter.*", "zone_lwip_hooks.*", "ui_zones.cpp"], "cost": { "flash_kb": 90 },
      "hint": "Forwarding, NAT, Policies zwischen Netzen. Tabellen im PSRAM. Noetig fuer Tethering und VPN-Gateway." },
    { "key": "WIREGUARD",  "layer": "network", "label": "WireGuard",         "status": "wired",    "default": 1, "requires": ["NET"],
      "files": ["wireguard_service.*", "src/WireGuard/**"], "cost": { "flash_kb": 104 }, "hint": "Server- und Client-Rolle, eigene Software-Krypto." },
    { "key": "IPSEC",      "layer": "network", "label": "IPsec/IKEv2",       "status": "wired",    "default": "soc:psram", "requires": ["NET", "CRYPTO_AES"], "psram": true,
      "files": ["ipsec_service.*", "ipsec_runtime.*", "ipsec_crypto_caps.*", "ipsec_config_fields.*", "ipsec_trust_store.*", "src/weirdike/**"], "cost": { "flash_kb": 232 },
      "hint": "WeirdIKE-Client (FRITZ!Box/LANCOM). Groesster Flash-Posten der VPN-Seite." },
    { "key": "DYNDNS",     "layer": "network", "label": "DynDNS",            "status": "declared", "default": 1, "requires": ["NET", "TLS_CLIENT"],
      "files": ["DynDNS-Code in weirdos-esp32.ino"], "hint": "Dynamischer DNS-Updater ueber den Uplink." },
    { "key": "NETSCAN",    "layer": "network", "label": "Netz-Diagnose",     "status": "declared", "default": 1, "requires": ["NET"],
      "files": ["net_scan.*", "ui_netscan.cpp"], "cost": { "flash_kb": 46 }, "hint": "Ping/Portscan/Sniff/Kanalscan." },

    { "key": "VIDEO_HTTP", "layer": "video", "label": "MJPEG/HTTP",           "status": "declared", "default": 1, "requires": ["CAMERA", "HTTP"],
      "files": ["camera_server.*"], "hint": "MJPEG-Stream + /capture." },
    { "key": "RTSP",       "layer": "video", "label": "RTSP",                 "status": "wired",    "default": 1, "requires": ["CAMERA", "NET"],
      "files": ["rtsp_server.*"], "cost": { "flash_kb": 41 }, "hint": "RTSP/RTP-Server. Der genuegsame Streamingweg." },
    { "key": "H264",       "layer": "video", "label": "H.264",                "status": "declared", "default": "soc:h264hw", "requires": ["CAMERA"], "soc": ["h264hw"],
      "files": ["h264_encoder.*", "h264_fmp4.*", "h264_guard.*", "ppa_converter.*"], "cost": { "dma_ram_kb": 166 }, "hint": "HW-Encoder + PPA + fMP4. Nur P4." },
    { "key": "UVC",        "layer": "video", "label": "USB-Webcam",           "status": "declared", "default": "feature:USB_DEVICE", "requires": ["CAMERA", "USB_DEVICE"],
      "files": ["usb_device_service.*", "usb_uvc_testimage.h"], "hint": "Das Board als Webcam am PC. Heute Testbild; echte Kamera folgt." },

    { "key": "HTTP",       "layer": "control", "label": "HTTP-Server",       "status": "declared", "default": 1, "requires": ["NET"],
      "files": ["weird_http_esp.*", "http_transport_esp32.cpp", "weird_auth.*"], "hint": "Transport + Auth. Basis fuer WEBUI, VIDEO_HTTP, OTA." },
    { "key": "WEBUI",      "layer": "control", "label": "Weboberflaeche",    "status": "declared", "default": 1, "requires": ["HTTP"],
      "files": ["web_ui.*", "web_ui_assets.cpp", "web_ui_menu.cpp", "ui_*.cpp"], "cost": { "flash_kb": 124 }, "hint": "Seiten + Assets (unkomprimiert der groesste Flash-Posten -> gzip)." },
    { "key": "CONSOLE",    "layer": "control", "label": "Serielle Konsole",  "status": "declared", "default": 1, "requires": [],
      "files": ["serial_console.*"], "cost": { "flash_kb": 85 }, "hint": "Kontrollpfad ohne Netz (P4 ohne Funk)." },
    { "key": "OTA",        "layer": "control", "label": "OTA-Update",        "status": "declared", "default": 1, "requires": ["HTTP"],
      "files": ["OTA-Code in weirdos-esp32.ino"], "hint": "Braucht ein Partitionsschema mit zwei App-Slots." },
    { "key": "BACKUP",     "layer": "control", "label": "Sicherung",         "status": "declared", "default": 1, "requires": [],
      "files": ["settings_backup.*"], "hint": "NVS-Export/-Import, Geheimnisse ausgeschlossen." },
    { "key": "TLS_SERVER", "layer": "control", "label": "HTTPS",             "status": "declared", "default": 1, "requires": ["HTTP"],
      "files": ["tls_selfsigned.*", "cert_store.*"], "hint": "HTTPS fuer die Verwaltung; Self-Signed immer moeglich." },
    { "key": "TLS_CLIENT", "layer": "control", "label": "HTTPS-Client",      "status": "declared", "default": 1, "requires": ["NET"],
      "files": ["http_transport.h", "http_transport_esp32.cpp"], "hint": "Ausgehende HTTPS-Verbindungen (DynDNS, ACME)." },
    { "key": "ACME",       "layer": "control", "label": "Let's Encrypt",     "status": "declared", "default": 1, "requires": ["TLS_SERVER", "TLS_CLIENT"],
      "files": ["acme_client.*"], "hint": "Echtes Zertifikat; braucht oeffentliche IPv4 + Uhr." },
    { "key": "CRYPTO_AES", "layer": "control", "label": "AES-Treiber",       "status": "declared", "default": "feature:IPSEC", "requires": [],
      "files": ["aes_engine.*", "aes_soft.*"], "hint": "HW-Block/Software-AES. Zulieferer fuer IPSEC." },

    { "key": "DETECTION",  "layer": "future", "label": "Erkennung",          "status": "planned", "default": 0, "requires": ["CAMERA"], "files": [], "hint": "Muster-/Objekterkennung -> Ereignisse (Tuerklingel, Tueroeffner)." },
    { "key": "AUDIO",      "layer": "future", "label": "Audio",              "status": "planned", "default": 0, "requires": [], "files": ["audio_source.h"], "hint": "Mikrofon/Lautsprecher (Gegensprechen). Nur Schnittstelle." },
    { "key": "ACTUATOR",   "layer": "future", "label": "Aktor",              "status": "planned", "default": 0, "requires": [], "files": [], "hint": "GPIO-Aktor (Tueroeffner, Klingeltaster)." }
  ],
  "runtime_conflicts": [
    { "modules": ["USB_HOST", "USB_DEVICE"], "on": ["esp32s3", "esp32s2"], "note": "Ein USB-Port: es laeuft nur eines (PC-Erkennung entscheidet). Auf dem P4 beides (zwei USB)." }
  ],
  "profiles": [
    { "id": "webcam",       "label": "USB-Webcam",               "modules": ["CAMERA", "USB_DEVICE", "UVC"], "note": "Kein IP-Stack. Kleinstes Bild-Profil." },
    { "id": "rtsp-wifi",    "label": "RTSP-Kamera (WLAN)",        "modules": ["CAMERA", "RTSP", "NET", "WIFI", "HTTP", "WEBUI"], "note": "WEBUI nur zum Einrichten; danach CONSOLE-los headless." },
    { "id": "rtsp-lte",     "label": "RTSP-Kamera (LTE)",         "modules": ["CAMERA", "RTSP", "NET", "USB_HOST", "MODEM", "CONSOLE"], "note": "Auf dem P4 der typische Feldbetrieb." },
    { "id": "vpn-gateway",  "label": "VPN-Gateway",               "modules": ["NET", "WIFI", "USB_HOST", "MODEM", "WIREGUARD", "IPSEC", "CRYPTO_AES", "ROUTER", "HTTP", "WEBUI", "TLS_SERVER"], "note": "Kein Bild. Uplink + Tunnel + Weitergabe." },
    { "id": "usb-tether",   "label": "USB-Tethering",             "modules": ["NET", "USB_HOST", "MODEM", "USB_DEVICE", "USB_NCM", "ROUTER"], "note": "Nur P4 (Host UND Device gleichzeitig). USB_NCM noch geplant." },
    { "id": "wifi-hotspot", "label": "WLAN-Hotspot (Modem)",      "modules": ["NET", "USB_HOST", "MODEM", "WIFI", "ROUTER", "HTTP", "WEBUI"], "note": "Nur mit Funk (nicht P4)." },
    { "id": "doorbell",     "label": "Tuerklingel",               "modules": ["CAMERA", "VIDEO_HTTP", "RTSP", "NET", "WIFI", "HTTP", "WEBUI", "DETECTION", "ACTUATOR", "AUDIO"], "note": "DETECTION/ACTUATOR/AUDIO geplant." },
    { "id": "full",         "label": "Vollausbau (Entwickler)",   "modules": ["*"], "note": "Alles, was der SoC kann. Heap-Warnung." }
  ]
}
